// Clepso's site on Cloudflare Workers static assets (20 Nov 2026): Vercel blocked the owner's team for an unpaid invoice
// on 19 Nov, so clepso-app.vercel.app is down. Files only, no Worker code: every request is a static asset, free and
// unlimited on the free plan. Deploy from this folder with `npx wrangler deploy`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "clepso",
  "compatibility_date": "2026-11-01",
  // Installed apps read the update feed from clepso.ledger-trigger.workers.dev, so it stays on. Keep this line: once
  // routes are listed, wrangler turns workers.dev off unless it is set here.
  "workers_dev": true,
  // The short address (22 Nov 2026), a custom domain on the elvisobi.com zone. Listed here so a deploy keeps it.
  "routes": [{ "pattern": "clepso.elvisobi.com", "custom_domain": true }],
  // no extra public preview address per upload
  "preview_urls": false,
  "assets": {
    "directory": ".",
    // vercel.json had "trailingSlash": true: /docs answers with a redirect to /docs/
    "html_handling": "force-trailing-slash",
    // Vercel served 404.html with a 404 for any missing path
    "not_found_handling": "404-page"
  }
}
