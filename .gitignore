.build
.swiftpm/
*.xcodeproj
DerivedData/
.DS_Store
site/.vercel/
.tools/
Tests/MCPClient/node_modules/
build/
App/ClepsoMac/Info.plist
App/ClepsoMac/ClepsoMac.entitlements
App/ClepsoWidgets/Info.plist
App/ClepsoWidgets/ClepsoWidgets.entitlements

# Local build configuration: signing identity and the accounts project (Config/*.example are the templates)
Config/*.local.xcconfig
*.local.xcconfig
Config/local.mk

# Secrets and signing material must never be committed
.env
.env.*
!.env.example
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
*.pem
*.key

# Local data: databases, exports and logs
*.sqlite
*.sqlite-shm
*.sqlite-wal
Clepso export *.json
*.log

# The web dashboard's accounts project, generated by scripts/build-site.py from Config/Sync.local.xcconfig
site/app/config.js

# Supabase CLI working files, wherever the CLI was run from (the project lives in backend/supabase)
**/supabase/.temp/
**/supabase/.branches/
