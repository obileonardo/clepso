// Build settings for the Xcode project that XcodeGen generates from project.yml (project level, every target).
//
// The defaults below are what a build from source gets: ad-hoc signing and no accounts project, so Sync stays off
// (Clepso never signs in or uploads anything). Official builds override them in two local files that are never
// committed (see .gitignore):
//
//   Config/Signing.local.xcconfig   signing identity and team        (template: Signing.local.xcconfig.example)
//   Config/Sync.local.xcconfig      accounts project host and key    (template: Sync.local.xcconfig.example)
//
// `#include?` is an optional include: a missing file is not an error.

CLEPSO_CODE_SIGN_IDENTITY = -
CLEPSO_DEVELOPMENT_TEAM =
CLEPSO_SYNC_HOST =
CLEPSO_SYNC_PUBLISHABLE_KEY =
CLEPSO_SYNC_PROVIDERS =
CLEPSO_WIDGET_GROUP = $(CLEPSO_DEVELOPMENT_TEAM).com.elvisobi.clepso.widgets

#include? "Signing.local.xcconfig"
#include? "Sync.local.xcconfig"
